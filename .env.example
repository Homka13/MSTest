# Скопіюйте цей файл у .env та вкажіть реальні значення з вашої App Registration в Microsoft Entra ID
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Домен входу для тенанта Microsoft Entra External ID (CIAM).
# Для звичайного workforce-тенанта натомість використовується login.microsoftonline.com.
VITE_AZURE_CIAM_DOMAIN=yourtenant.ciamlogin.com
